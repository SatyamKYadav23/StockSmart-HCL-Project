# =============================================================================
# StockSmart Backend Environment Configuration Template
# Copy this file to .env and replace the values with your local settings:
#   cp .env.example .env
# =============================================================================

# Server Port
SERVER_PORT=8080

# Database Connectivity
DB_URL=jdbc:mysql://localhost:3306/stocksmart?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password

# Hibernate Configuration
# Options: update (development), validate (recommended for production), none
DDL_AUTO=update
SHOW_SQL=false
FORMAT_SQL=false

# CORS Allowed Origins (Comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000
